model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String   @unique
  imageUrl    String?
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products Product[]

  @@index([name])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}
