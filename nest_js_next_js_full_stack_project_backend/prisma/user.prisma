enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String?
  firstName    String?
  lastName     String?
  role         Role     @default(USER)
  refreshToken String?
  profileImage String?
  phoneNumber  String?
  address      String?
  bio          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  carts    Cart[]
  orders   Order[]
  payments Payment[]

  @@index([email])
  @@index([firstName, lastName])
  @@index([role])
  @@map("users")
}
